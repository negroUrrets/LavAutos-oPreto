@startuml Esquema Base Datos
' Fuente editable de "Esquema Base Datos.png".
' Exportar a PNG con PlantUML (CLI o https://www.plantuml.com/plantuml) y reemplazar el PNG.
' Refleja el modelo final de src/databaseLavadero/script db/DataBaseLavadero.sql,
' incluida la agregacion de Utileria y EstadoLavado y los cambios de Lavado.

hide circle
skinparam classAttributeIconSize 0
skinparam linetype ortho

class Persona {
  + codigoPersona : bigint <<PK>>
  + nombre : varchar(100)
  + apellido : varchar(100)
  + dni : bigint
  + email : varchar(150)
  + celular : bigint
}

class Cliente {
  + codigoPersona : bigint <<PK, FK>>
  + estadoCliente : bit
}

class CategoriaVehiculo {
  + codigoCategoriaVehi : bigint <<PK>>
  + categoriaVehi : varchar(100)
}

class MarcaVehiculo {
  + codigoMarcaVehi : bigint <<PK>>
  + marcaVehi : varchar(100)
  + categoriaVehi : bigint <<FK>>
}

class ModeloVehiculo {
  + codigoModeloVehi : bigint <<PK>>
  + modeloVehi : varchar(100)
  + marcaVehi : bigint <<FK>>
}

class Vehiculo {
  + codigoVehi : bigint <<PK>>
  + patenteVehi : varchar(20)
  + estadoVehi : bit
  + cliente : bigint <<FK>>
  + modeloVehi : bigint <<FK>>
}

class Usuario {
  + codigoUsuario : bigint <<PK>>
  + nombreUsuario : varchar(100)
  + contraseña : varchar(255)
}

class Login {
  + codigoLogin : bigint <<PK>>
  + usuario : bigint <<FK>>
}

class CategoriaLavado {
  + codigoCategoriaLavado : bigint <<PK>>
  + descripcionLavado : varchar(200)
}

class EstadoLavado {
  + codigoEstado : bigint <<PK>>
  + descripcionEstado : varchar(200)
  + estadoLavado : bit
}

class Utileria {
  + codigoUtileria : bigint <<PK>>
  + descripcionUtileria : varchar(200)
  + estadoUtileria : bit
}

class Lavado {
  + codigoLavado : bigint <<PK>>
  + fechaHoraLavado : datetime2
  + vehi : bigint <<FK>>
  + categoriaLavado : bigint <<FK>>
  + login : bigint <<FK>>
  + estado : bigint <<FK>>
  + utileria : bigint <<FK>>
  + detallesLavado : varchar(255)
}

Persona "1" <|-- "0..1" Cliente : hereda
Cliente "1" -- "0..*" Vehiculo
ModeloVehiculo "1" -- "0..*" Vehiculo
MarcaVehiculo "1" -- "0..*" ModeloVehiculo
CategoriaVehiculo "1" -- "0..*" MarcaVehiculo
Vehiculo "1" -- "0..*" Lavado
CategoriaLavado "1" -- "0..*" Lavado
Usuario "1" -- "0..*" Login
Login "1" -- "0..*" Lavado
EstadoLavado "1" -- "0..*" Lavado
Utileria "1" -- "0..*" Lavado

@enduml
