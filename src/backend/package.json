{
  "name": "lavadero-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend REST del lavadero de vehiculos (Express + Sequelize + SQL Server)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
